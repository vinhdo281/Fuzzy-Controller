<mujoco model="full_pendulum_assem">
  <compiler angle="radian" coordinate="local"/>
  <size memory="10000000"/>

  <option timestep="0.002" gravity="0 0 -9.81" integrator="RK4"/>


  <asset>
    <material name="grid"      rgba="0.15 0.25 0.35 1"/>
    <material name="cart_mat"  rgba="0.2 0.4 0.8 1"/>
    <material name="pole_mat"  rgba="0.9 0.2 0.2 1"/>
    <material name="rail_mat"  rgba="0.6 0.6 0.6 0.9"/>
    <material name="hinge_mat" rgba="0.1 0.1 0.1 1"/>
  </asset>

  <worldbody>
    <geom name="floor" type="plane" size="2 2 0.1" material="grid" contype="0" conaffinity="0"/>

    <!-- Rail: chinh xac 0.4875 m moi ben (tong 0.975 m) tu worldframe trong full_pendulum_assem.xml -->
    <geom name="rail"       type="capsule" fromto="-0.4875 0 0.2 0.4875 0 0.2" size="0.006" material="rail_mat" contype="0" conaffinity="0"/>
    <geom name="left_stop"  type="box" pos="-0.4875 0 0.2" size="0.01 0.04 0.04" rgba="0.3 0.3 0.3 1" contype="0" conaffinity="0"/>
    <geom name="right_stop" type="box" pos=" 0.4875 0 0.2" size="0.01 0.04 0.04" rgba="0.3 0.3 0.3 1" contype="0" conaffinity="0"/>

    <!-- Cart Body - Thong so chinh xac tu SolidWorks full_pendulum_assem.xml -->
    <!-- Mass = 0.05911769838837861 kg -->
    <!-- CoM  = [0, 0, -0.0084268671803051261] m -->
    <!-- Inertia (Ixx,Iyy,Izz) = [2.1955e-5, 5.8487e-5, 6.5129e-5] kg.m^2 -->
    <body name="cart" pos="0 0 0.2">
      <inertial pos="0 0 -0.0084269"
                mass="0.05911770"
                diaginertia="2.1955e-5 5.8487e-5 6.5129e-5"/>
      <joint name="cart_slider" type="slide" axis="1 0 0"
             range="-0.45 0.45" damping="0.05" frictionloss="0.01"/>
      <geom name="cart_geom"         type="box"      size="0.04 0.03 0.02" material="cart_mat"  contype="0" conaffinity="0"/>
      <geom name="cart_hinge_bearing" type="cylinder" size="0.008 0.015" pos="0 0 0.02"
            quat="0.7071 0.7071 0 0" material="hinge_mat" contype="0" conaffinity="0"/>

      <!-- Pole Body - Thong so chinh xac tu SolidWorks full_pendulum_assem.xml -->
      <!-- Mass = 0.019633826078982265 kg -->
      <!-- CoM  = 0.11062852776227509 m doc theo truc con lac -->
      <!-- I_com (truc x) = 1.9733090023537565e-4 kg.m^2 -->
      <!-- I_zz (quay quanh truc) = 1.1898645849201206e-5 kg.m^2 -->
      <body name="pole" pos="0 0 0.02">
        <inertial pos="0 0 0.11062853"
                  mass="0.01963383"
                  diaginertia="1.9733e-4 1.9733e-4 1.1899e-5"/>
        <joint name="pole_hinge" type="hinge" axis="0 1 0"
               damping="0.0003" frictionloss="0.00005"/>
        <!-- Pole visual: dai 0.244 m (uoc tinh tu COM = 0.1106 m) -->
        <geom name="pole_geom" type="capsule" fromto="0 0 0 0 0 0.244" size="0.004" material="pole_mat" contype="0" conaffinity="0"/>
        <geom name="pole_tip"  type="sphere"  pos="0 0 0.244" size="0.008" rgba="1 0.8 0.1 1"           contype="0" conaffinity="0"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!-- Luc day theo ray, bao hoa +/-10 N -->
    <motor name="cart_force" joint="cart_slider" gear="1" ctrllimited="true" ctrlrange="-10 10"/>
  </actuator>

</mujoco>
